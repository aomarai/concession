# Used by `docker compose --profile app up --build`. Copy to .env (gitignored).
# Secrets stay in .env or your environment, never in the repo.

# Host port for the app (the frontend container serves the UI and proxies /api)
APP_PORT=8080

# Google OAuth client (Authorized redirect URI must equal GOOGLE_REDIRECT_URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# TMDB "API Read Access Token" (v4 bearer token)
TMDB_READ_ACCESS_TOKEN=

# Database (change the password for anything but local use)
DB_USER=concession
DB_PASSWORD=concession
DB_NAME=concession

# false for plain http://localhost; true behind HTTPS
COOKIE_SECURE=false

# Optional: rate limits and trusted proxies are described in docs/DEVELOPMENT.md.
# The frontend container has a fixed address on its own small network, and only
# that address is trusted to report client IPs. Change the subnet/address if
# 172.29.250.0/24 clashes with another Docker network on your machine.
# APP_SUBNET=172.29.250.0/24
# FRONTEND_IP=172.29.250.10
# If another proxy or load balancer sits in front of the frontend container, add
# its address to TRUSTED_PROXIES as well (comma-separated, keep the frontend's):
# TRUSTED_PROXIES=172.29.250.10,203.0.113.5
