# Copy to backend/.env (gitignored) and fill in.
ENV=development
PORT=8080

# sqlite (default) or postgres
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=concession
DB_PASSWORD=concession
DB_NAME=concession
# DB_PATH=concession.db   # used when DB_DRIVER=sqlite

# Local http dev needs non-secure cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

CORS_ALLOWED_ORIGINS=http://localhost:5173

# TMDB "API Read Access Token" (v4 bearer token) from themoviedb.org settings
TMDB_READ_ACCESS_TOKEN=
# TMDB_BASE_URL=   # override only for tests/proxies
